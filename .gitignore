/site/**/docs/
/site/**/Qa/
/site/**/qa/
/site/**/tools/
/site/**/tests/
/site/**/test/
/site/**/node_modules/
/site/**/tmp/
/site/**/Output/
/site/**/Lecture_Original/
/site/**/assets/pages/
/site/**/*.pdf
/site/**/*.ppt
/site/**/*.pptx
/site/**/*.zip
/site/**/*.tar
/site/**/*.gz
/site/**/*.md
/site/**/*.py
/site/**/*.cjs
/site/**/*.mjs
/site/**/*.ps1
/site/**/*.exe
/site/**/*.o
/site/**/*.obj
